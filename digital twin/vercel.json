{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/predict-ecg",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "static/$1"
    }
  ]
}
